# VirusTotal API Key (Optional. If unset, VirusTotal enrichment is skipped gracefully)
VIRUSTOTAL_API_KEY=

# VirusTotal Tuning
VT_TIMEOUT_SECONDS=10
VT_CACHE_DIR=.vt_cache
VT_CACHE_TTL_SECONDS=86400
VT_ENABLED=true

# Database Configuration (Defaults to MySQL; falls back to SQLite if MySQL is unavailable)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=detectlab_phishing

# Flask Secret Key
SECRET_KEY=detectlab-dev-secret-key-change-in-production
